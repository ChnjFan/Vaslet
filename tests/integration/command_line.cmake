function(check_command program expected_result output_pattern error_pattern)
  execute_process(COMMAND "${program}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "${expected_result}")
    message(FATAL_ERROR "${program} ${ARGN}: exit ${result}, expected ${expected_result}: ${error}")
  endif()
  if("${output_pattern}" STREQUAL "")
    if(NOT "${output}" STREQUAL "")
      message(FATAL_ERROR "Unexpected stdout: ${output}")
    endif()
  elseif(NOT output MATCHES "${output_pattern}")
    message(FATAL_ERROR "Unexpected stdout: ${output}")
  endif()
  if("${error_pattern}" STREQUAL "")
    if(NOT "${error}" STREQUAL "")
      message(FATAL_ERROR "Unexpected stderr: ${error}")
    endif()
  elseif(NOT error MATCHES "${error_pattern}")
    message(FATAL_ERROR "Unexpected stderr: ${error}")
  endif()
endfunction()

foreach(program IN ITEMS "${SERVER}" "${CLI}")
  get_filename_component(program_name "${program}" NAME)
  set(help_pattern "Usage: ${program_name} .*Options:.*-h, --help .*Show this help message.*-v, --version .*Show the program version.*not implemented")
  foreach(option IN ITEMS --help -h -hv -vh)
    check_command("${program}" 0 "${help_pattern}" "" "${option}")
  endforeach()
  foreach(option IN ITEMS --version -v)
    check_command("${program}" 0 "^${program_name} [0-9]+[.][0-9]+[.][0-9]+\n$" "" "${option}")
  endforeach()
  check_command("${program}" 0 "${help_pattern}" "" --help --version)
  check_command("${program}" 0 "${help_pattern}" "" --version --help)
  check_command("${program}" 0 "${help_pattern}" "" --help -h)
  check_command("${program}" 0 "${help_pattern}" "" --help --)
  if("${program}" STREQUAL "${SERVER}")
    set(unavailable_error "")
  else()
    set(unavailable_error "not implemented")
  endif()
  check_command("${program}" 1 "" "${unavailable_error}")
  check_command("${program}" 1 "" "${unavailable_error}" --)
  foreach(option IN ITEMS --unknown -x -hx --he --help=yes --version=1 file -)
    check_command("${program}" 1 "" "invalid argument: ${option}" "${option}")
    check_command("${program}" 1 "" "invalid argument: ${option}" --help "${option}")
  endforeach()
  check_command("${program}" 1 "" "invalid argument: --help" -- --help)
endforeach()

# The service accepts a path but does not read it or start serving yet.
foreach(option IN ITEMS -c --config)
  check_command("${SERVER}" 1 "" "" "${option}" "/tmp/vaslet.json")
  check_command("${SERVER}" 0 "--config <value>" "" "${option}" "/tmp/vaslet.json" --help)
  check_command("${SERVER}" 1 "" "invalid argument: ${option}" "${option}")
  check_command("${SERVER}" 1 "" "invalid argument: ${option}" "${option}" --help)
endforeach()
foreach(option IN ITEMS -c/tmp/vaslet.json --config=/tmp/vaslet.json)
  check_command("${SERVER}" 1 "" "" "${option}")
endforeach()
