foreach(program IN ITEMS "${SERVER}" "${CLI}")
  get_filename_component(program_name "${program}" NAME)
  foreach(option IN ITEMS --help --version)
    execute_process(COMMAND "${program}" "${option}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "0" OR "${output}" STREQUAL "")
      message(FATAL_ERROR "${program} ${option} failed: ${result} ${error}")
    endif()
    if("${option}" STREQUAL "--help" AND NOT output MATCHES "Usage: ${program_name} ")
      message(FATAL_ERROR "Help output has the wrong program name: ${output}")
    elseif("${option}" STREQUAL "--version" AND NOT output MATCHES "^${program_name} ")
      message(FATAL_ERROR "Version output has the wrong program name: ${output}")
    endif()
  endforeach()
  foreach(option IN ITEMS "" --unknown)
    if("${option}" STREQUAL "")
      execute_process(COMMAND "${program}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    else()
      execute_process(COMMAND "${program}" "${option}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    endif()
    if(NOT "${result}" STREQUAL "1" OR NOT error MATCHES "not implemented")
      message(FATAL_ERROR "${program} must report unavailable functionality: ${result} ${error}")
    endif()
  endforeach()
endforeach()
